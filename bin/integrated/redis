#!/bin/bash

# This could be run as a background process to parallel
RUNTIME=${RUNTIME:-io.containerd.runc.v2}
NAME=${NAME:-dummy}
ROUNDS=${ROUNDS:-1}
MEM=${MEM:-4G}
REALMEM=$(echo "$MEM" | cut -d G -f 1)
REALMEM="$((REALMEM + 1))G"
NSERVERS=${NSERVERS:-4}
NCLIENTS=${NCLIENTS:-4}

# Server Side Initialization (Just use the temporary filesystem)
nerdctl run -d \
  $EXTRA_SERVER_FLAGS \
  --runtime "$RUNTIME" \
  -m "$REALMEM" \
  --name "$NAME" \
  --cpus "$NSERVERS" \
  $SCPUSET \
  --tmpfs /tmp:size=$MEM \
  "toolmanp/ioperf-dockerized:22.04-zpoline" \
  ${ZRUN:-} redis-server --bind 0.0.0.0 --dir /tmp &> /dev/null

sleep 1

IP=$(nerdctl inspect --format '{{.NetworkSettings.IPAddress}}' "$NAME")

# Client Side Benchmarking (Use native runc)
for _ in $(seq 1 "$ROUNDS"); do
nerdctl run \
  --rm \
  $CCPUSET \
  "toolmanp/ioperf-dockerized:22.04-zpoline" \
  redis-benchmark -c "$NCLIENTS" -h "$IP" -p 6379 | tee -a "$LOGS/$NAME".log
done

sleep 1

nerdctl rm --force "$NAME" &> /dev/null
