#!/bin/bash

# This could be run as a background process to parallel
RUNTIME=${RUNTIME:-io.containerd.runc.v2}
NAME=${NAME:-dummy}
SNAME=${SNAME:-$NAME-server}
CNAME=${CNAME:-$NAME}
ROUNDS=${ROUNDS:-1}
MEM=${MEM:-4G}
REALMEM=$(echo "$MEM" | cut -d G -f 1)
REALMEM="$((REALMEM + 1))G"
NSERVERS=${NSERVERS:-4}
NCLIENTS=${NCLIENTS:-4}

# Server Side Initialization (Just use the temporary filesystem)
nerdctl run -d \
  $EXTRA_SERVER_FLAGS \
  --runtime "$RUNTIME" \
  -m "$REALMEM" \
  --name "$SNAME" \
  --cpus "$NSERVERS" \
  $SCPUSET \
  --tmpfs /tmp:size=$MEM \
  "toolmanp/ioperf-dockerized:22.04-zpoline" \
  ${ZRUN:-} memcached -u memcache -m "$MEM" -t "$NSERVERS" &> /dev/null

sleep 1

IP=$(nerdctl inspect --format '{{.NetworkSettings.IPAddress}}' "$SNAME")

# Client Side Benchmarking (Use native runc)
for _ in $(seq 1 "$ROUNDS"); do
nerdctl run \
  --rm \
  --name "$CNAME" \
  -v $ROOT/bin/barrier:/barrier \
  $CCPUSET \
  "toolmanp/ioperf-dockerized:22.04-zpoline" \
  bash -c "$SYNC_PRI memslap -c $NCLIENTS -s "$IP:11211" -t hybrid -F -l 100000 -e 100000" | tee -a "$LOGS/$CNAME".log
done

sleep 1
nerdctl rm --force "$SNAME" &> /dev/null
