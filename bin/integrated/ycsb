#!/bin/bash

# This could be run as a background process to parallel
RUNTIME=${RUNTIME:-io.containerd.runc.v2}
NAME=${NAME:-dummy}
ROUNDS=${ROUNDS:-1}
MEM=${MEM:-4G}
REALMEM=$(echo "$MEM" | cut -d G -f 1)
REALMEM="$((REALMEM + 1))G"
NSERVERS=${NSERVERS:-4}
NCLIENTS=${NCLIENTS:-4}

# Server Side Initialization (Just use the temporary filesystem)
nerdctl run -d \
  $EXTRA_SERVER_FLAGS \
  --runtime "$RUNTIME" \
  -m "$REALMEM" \
  --name "$NAME" \
  --cpus "$NSERVERS" \
  $SCPUSET \
  --tmpfs /tmp \
  "toolmanp/ioperf-dockerized:22.04-zpoline" \
  bash -c "mv /var/lib/mysql /tmp/mysql && ${ZRUN:-} mysqld  --bind-address=0.0.0.0 --init-file=/ioperf/mysqld-init.sql --datadir=/tmp/mysql" &> /dev/null

sleep 10

IP=$(nerdctl inspect --format '{{.NetworkSettings.IPAddress}}' "$NAME")
# Client Side Benchmarking (Use native runc)
for _ in $(seq 1 "$ROUNDS"); do
nerdctl run \
  --rm \
  $CCPUSET \
  "toolmanp/go-ycsb-rocksdb-dockerized:22.04-zpoline" \
  bash -c "export workloads=\"a b c d e f\"; for w in \$workloads; do go-ycsb load mysql -p threadcount="$NCLIENTS" -p mysql.host="$IP" -p mysql.password=root -P /workloads/workload\$w && go-ycsb run mysql -p threadcount="$NCLIENTS" -p mysql.host="$IP" -p mysql.password=root -P /workloads/workload\$w; done" | tee -a "$LOGS/$NAME".log

done

sleep 1

nerdctl rm --force "$NAME" &> /dev/null
