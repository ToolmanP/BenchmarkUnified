#!/bin/bash

TIMESTAMP=$(date +%s)
MODE="multi"
BARRIER_ROOT=${BARRIER_ROOT:-$ROOT/bin/barrier}
. "$ROOT"/bin/env

if ! eval set -- "$(getopt -o n:i: --long rounds:,affinity -- "$@")"; then
  exit $?
fi

while true; do
  case $1 in
    --rounds)
      ROUNDS="$2"
      shift 2
      ;;
    --affinity)
      MODE="multi-affinity"
      shift
      ;;
    -n)
      NAME="$2"
      shift 2
      ;;
    -i)
      INTEGRATION="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

PROG="$ROOT/bin/integrated/$INTEGRATION"

if [[ ! -f $PROG ]]; then
  echo "File $PROG does not exist" >&2
  exit 
fi

pids=()
rm -f $BARRIER_ROOT/ready
for i in $(seq 0 2 $((CONTAINERS - 1))); do
  SNAME="$INTEGRATION-$NAME-$TIMESTAMP-$((i/2))-server-bg"
  CNAME="$INTEGRATION-$NAME-$TIMESTAMP-$((i/2))-client-bg"
  if [[ $MODE == "multi-affinity" ]]; then
    SCPUSET="--cpuset-cpus=$(circular_seq "$i" "$NSERVERS" "$CONTAINERS" "$PROCS")"
    CCPUSET="--cpuset-cpus=$(circular_seq "$((i+1))" "$NSERVERS" "$CONTAINERS" "$PROCS")"
  else
    SCPUSET=""
    CCPUSET=""
  fi
  env SYNC_PRI="$SYNC_PRI" SCPUSET="$SCPUSET" CCPUSET="$CCPUSET" SNAME="$SNAME" CNAME="$CNAME" "$PROG" &> /dev/null &
  pids+=("$!")
done
for i in $(seq 0 2 $((CONTAINERS - 1))); do
  SNAME="$INTEGRATION-$NAME-$TIMESTAMP-$((i/2))-server-bg"
  while ! nerdctl inspect $SNAME &> /dev/null ; do
    sleep 1
  done
done
touch $BARRIER_ROOT/ready
for pid in "${pids[@]}"; do
  waitpid -e "$pid"
done
