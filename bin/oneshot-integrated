#!/bin/bash

ROUNDS=${ROUNDS:-1}
NAME=${NAME:-dummy}
RUNTIME=${RUNTIME:-"io.containerd.runc.v2"}

if ! eval set -- "$(getopt -o r:n:i: --long rounds: -- "$@")"; then
  exit $?
fi

while true; do
  case $1 in
    --rounds)
      ROUNDS="$2"
      shift 2
      ;;
    -n)
      NAME="$2"
      shift 2
      ;;
    -i)
      INTEGRATION="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done


NAME="$INTEGRATION-$NAME-$(date +%s)"
export NAME
INTEGRATION="$ROOT/bin/integrated/$INTEGRATION"

if [[ ! -f $INTEGRATION ]]; then
  echo "File $INTEGRATION does not exist" >&2
fi

exec $INTEGRATION
